# ── Birdeye Data API key ───────────────────────────────────────────────────
# Server-side only: never prefix it with NEXT_PUBLIC_. Get one at
# https://data.birdeye.so
# Visitors can also paste their own key in the app; theirs takes precedence.
# Leave this unset on a public deployment to make every visitor bring a key.
BIRDEYE_API_KEY=

# ── Protect a public deployment (recommended on Vercel) ─────────────────────
# A shared link can spend your compute units. Set a site-wide password
# (HTTP Basic auth, any username) for demos; leave unset to stay open.
# SITE_PASSWORD=

# Requests per minute per IP for the routes that spend compute units
# (/api/token and /api/tags; /api/ohlcv gets 3x). Counted per server
# instance, so treat it as a speed bump. 0 turns it off. Default 20.
# RATE_LIMIT_PER_MINUTE=20

# ── Birdeye client ──────────────────────────────────────────────────────────
# BIRDEYE_BASE_URL=https://public-api.birdeye.so
# Parallel requests per process.
# BIRDEYE_CONCURRENCY=12
# Retries on 429 and 5xx, with backoff.
# BIRDEYE_MAX_RETRIES=4
# BIRDEYE_TIMEOUT_MS=20000

# ── Cache ───────────────────────────────────────────────────────────────────
# Birdeye responses, token charts and tag layers are cached in process for
# this long, per API key. Swap in Redis before running several instances.
# CACHE_TTL_SECONDS=300
